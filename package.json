{
  "name": "qiniu-maas-plugin",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm --filter @qiniu/maas-sdk build && pnpm --filter @qiniu/dsh-qiniu-maas build",
    "test": "vitest run",
    "typecheck": "pnpm --filter @qiniu/maas-sdk build && pnpm -r typecheck",
    "package:smoke": "pnpm --filter @qiniu/maas-sdk build && pnpm --filter @qiniu/dsh-qiniu-maas build && node scripts/package-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
