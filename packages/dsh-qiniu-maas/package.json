{
  "name": "@qiniu/dsh-qiniu-maas",
  "version": "0.1.0",
  "private": true,
  "description": "Qiniu MaaS model marketplace and native DSH provider integration",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib/**/*.js", "lib/**/*.js.map", "lib/types/**/*.d.ts", "lib/types/**/*.d.ts.map"],
  "dsh": {
    "client": {
      "inject": ["slots", "locale", "connection", "remote", "settingsScope", "settingsSchema"],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "dependencies": {
    "@qiniu/maas-sdk": "workspace:*",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "*",
    "@types/react": "~18.3.1",
    "tsdown": "^0.22.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-credentials": "*"
  }
}
